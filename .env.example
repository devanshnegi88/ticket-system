# Port the HTTP server listens on. The assignment requires 8080.
PORT=8080

# Secret used to sign JWTs. MUST be changed to a long random value in
# any real deployment; never commit a real secret to source control.
JWT_SECRET=change-me-in-production

# How many hours a JWT stays valid after login.
JWT_EXPIRY_HOURS=24

# Path to the SQLite database file. Relative paths are created next to
# the running binary / working directory.
DATABASE_PATH=ticket_system.db
